+    match = re.search("^" + name + r" = (.*)$", flag_text, re.MULTILINE)
+    if match:
+        flags += shlex.split(match[1])
+if not any("STREMIO_USE_LIBVLC" in flag for flag in flags):
+    raise SystemExit("Requires the completed static VLC host build")

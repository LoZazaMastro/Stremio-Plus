+/* An individual decoder can fail without libVLC changing the media-player
+ * state. Report video failures to the embedding application; the callback
+ * must only record the error and defer stop/reopen until outside VLC locks. */
+static void stremio_ReportVideoError(decoder_t *dec, int error)
+{
+    void (*report)(void *, int) =
+        var_InheritAddress(dec, "stremio-video-error");
+    if (report != NULL)
+        report(var_InheritAddress(dec, "stremio-video-error-opaque"), error);
+}
+
 static inline void wait_mt(decoder_sys_t *sys)
 {
     vlc_sem_wait(&sys->sem_mt);
